# OPCIONAL: o docker-compose funciona sem .env (usa estes mesmos valores como padrão).
# Copie para .env (ignorado pelo Git) só se quiser trocar algum valor. Valores só para ambiente local.
ORACLE_SYS_PASSWORD=oracle_dev
ORACLE_APP_USER=parada
ORACLE_APP_PASSWORD=parada_dev
RABBITMQ_USER=parada
RABBITMQ_PASSWORD=parada_dev
MONGO_USER=parada
MONGO_PASSWORD=parada_dev

# Usados só pelo serviço "api". Ao rodar pelo VSCode, vale o appsettings.Development.json.
JWT_CHAVE=dev-somente-local-troque-em-producao-0123456789
CARTAO_CHAVE_HMAC=dev-somente-local-hmac-cartao-0123456789abcdef

# Portas no seu computador. Troque se alguma já estiver em uso.
API_PORTA=5117
ORACLE_PORTA=1521
RABBITMQ_PORTA=5672
RABBITMQ_PAINEL_PORTA=15672
MONGO_PORTA=27018
