{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API Dispositivos",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ParadaCerta.Dispositivos.Api/bin/Debug/net10.0/ParadaCerta.Dispositivos.Api.dll",
      "cwd": "${workspaceFolder}/src/ParadaCerta.Dispositivos.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5117"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
