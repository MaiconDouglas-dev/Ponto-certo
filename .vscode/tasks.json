{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/ParadaCerta.Dispositivos.sln", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/ParadaCerta.Dispositivos.sln"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "watch",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "run", "--project", "${workspaceFolder}/src/ParadaCerta.Dispositivos.Api"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "docker: subir dependências",
      "type": "shell",
      "command": "docker compose up -d oracle rabbitmq mongodb",
      "problemMatcher": []
    },
    {
      "label": "docker: subir tudo (com a API)",
      "type": "shell",
      "command": "docker compose up -d --build",
      "problemMatcher": []
    },
    {
      "label": "docker: derrubar tudo",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    }
  ]
}
